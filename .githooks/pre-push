#!/usr/bin/env bash
# Pre-push gate. Runs the fast, environment-independent checks LOCALLY before a push
# reaches origin, so a break is caught here instead of after it has landed on main.
#
# This is still the ONLY automatic gate in the repo. `.github/workflows/ci.yml` was
# restored on 2026-07-28, but every job in it is guarded on `repository.private != true`
# so that it bills no Actions minutes until this repo is public — which means it runs
# nothing and certifies nothing today, and the jobs it alone would run are manual.
# Deliberately still NOT gated here, because each needs an environment this hook cannot
# assume:
#   - JS typecheck + VS Code grammar  (need node)
#   - cargo audit / cargo deny advisory scan  (need the tools + network; run them on
#                                              any dependency change)
#
# The live-kernel tests used to head that list. They no longer do: the preflight below
# supplies exactly the environment the list said could not be assumed, and CHECKS it
# rather than assuming it. Where it cannot (no `.venv`), they skip as before and the
# preflight says so out loud.
#
# Only gates a push that includes main; WIP-branch pushes skip for speed (matching CI,
# which reserves the heavy gate for main + PRs). Bypass once with:  git push --no-verify
set -euo pipefail

# pre-push receives "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
# Read them ONCE into an array: stdin is a stream, so a second loop would see nothing.
refs=()
pushing_main=0
while read -r local_ref local_sha remote_ref remote_sha; do
    refs+=("$local_ref $local_sha $remote_ref $remote_sha")
    if [ "$remote_ref" = "refs/heads/main" ]; then
        pushing_main=1
    fi
done

cd "$(git rev-parse --show-toplevel)"

# ---------------------------------------------------------------------------
# Guard: refuse a push that ADDS a money/strategy note.
#
# Runs on every push, not just main, because a WIP branch can carry one just as
# easily. It matches only files ADDED by the pushed commits (--diff-filter=A):
# the purge set is still tracked today, so a check against the whole tree would
# refuse every push. Strategy notes belong in ~/Documents/personal/taliesin-private/.
# ---------------------------------------------------------------------------
purge_re='(^|/)(STARTUP-PLAN|FUNDING-RESEARCH)\.md$'
purge_re+='|(pmf-audit|due-diligence-audit|demand-positioning-audit|launch-critique|adoption-friction-audit)\.md$'
purge_re+='|(^|/)phase-2-inputs/'
zero='0000000000000000000000000000000000000000'
offenders=""
for line in "${refs[@]}"; do
    read -r _lref lsha _rref rsha <<<"$line"
    [ "$lsha" = "$zero" ] && continue          # branch deletion, nothing added
    if [ "$rsha" = "$zero" ]; then
        # New remote branch: diff against whatever is already published.
        base=$(git merge-base "$lsha" origin/main 2>/dev/null || true)
        [ -z "$base" ] && continue             # cannot establish a base; do not guess
    else
        base="$rsha"
    fi
    added=$(git diff --diff-filter=A --name-only "$base" "$lsha" 2>/dev/null || true)
    [ -n "$added" ] && offenders+=$(printf '%s\n' "$added" | grep -E "$purge_re" || true)
done
if [ -n "${offenders//[[:space:]]/}" ]; then
    echo "pre-push: REFUSED. These commits add money/strategy notes:" >&2
    printf '%s\n' "$offenders" | sed '/^$/d' | sort -u | sed 's/^/  /' >&2
    echo "" >&2
    echo "Those live in ~/Documents/personal/taliesin-private/, never in the repo." >&2
    echo "Deliberate? git push --no-verify" >&2
    exit 1
fi

if [ "$pushing_main" -eq 0 ]; then
    exit 0
fi

# ---------------------------------------------------------------------------
# Environment preflight for the suite below.
#
# WHY. Every live-kernel test gates on `TALIESIN_PYTHON` and *skips* when it is unset
# (`python_or_skip`, and the same shape in `kernel.rs`). So a bare push was always green
# over a suite that ran less than it looked like it ran — the hollow-gate failure
# `tools/gates.sh` exists to prevent, in the one gate here that runs automatically.
# Measured 2026-08-20: with `TALIESIN_PYTHON` unset the whole workspace suite passes and
# exits 0, having started no kernel at all.
#
# Script-side bash only. Nothing here touches exec or kernel recovery machinery
# ("hanging-interpreter recovery" is a do-not-rebuild entry and needs its own ruling).
#
# There is deliberately NO cargo-lock warning. A second concurrent cargo is not silent:
# cargo itself prints "Blocking waiting for file lock on package cache", repeatedly, for
# as long as it waits. Verified 2026-08-20 by holding the lock and starting a second
# suite. A hand-rolled warning would restate it less well.
# ---------------------------------------------------------------------------

# 1. Self-arm. Not a new policy: this is the interpreter resolution the tool already
#    commits to (`field -> <dir>/.venv -> TALIESIN_PYTHON -> ancestor .venv -> python3`,
#    crates/server/src/interpreter.rs), applied to the last consumer left guessing.
if [ -z "${TALIESIN_PYTHON:-}" ] && [ -x "$PWD/.venv/bin/python" ]; then
    export TALIESIN_PYTHON="$PWD/.venv/bin/python"
    echo "pre-push: armed TALIESIN_PYTHON=$TALIESIN_PYTHON (the repo's own .venv)"
fi

# 2. Poisoned env: set, but pointing at nothing runnable — a venv that was deleted or
#    moved. This does not skip and does not hang. Measured 2026-08-20: six kernel tests
#    fail ~30s in, with interpreter-spawn errors that name the missing path only in
#    passing, so the push looks like a code regression. One line beats thirty seconds.
if [ -n "${TALIESIN_PYTHON:-}" ] && [ ! -x "$TALIESIN_PYTHON" ]; then
    echo "pre-push: REFUSED. TALIESIN_PYTHON is set but not executable:" >&2
    echo "    $TALIESIN_PYTHON" >&2
    echo "Fix: unset TALIESIN_PYTHON, or point it at ./.venv/bin/python" >&2
    exit 1
fi

# 3. Bounded probe, mirroring the gate script's own ipykernel preflight. An interpreter
#    without ipykernel starts no kernel, so the live-kernel tests would fail on the
#    missing module rather than on the code being pushed. Bounded because a probe is not
#    worth a wedged push if the interpreter itself is on something that will not answer.
if [ -n "${TALIESIN_PYTHON:-}" ] \
    && ! timeout 20 "$TALIESIN_PYTHON" -c 'import ipykernel' >/dev/null 2>&1; then
    echo "pre-push: REFUSED. TALIESIN_PYTHON cannot import ipykernel:" >&2
    echo "    $TALIESIN_PYTHON" >&2
    echo "The live-kernel tests would fail on the module, not on your change." >&2
    echo "Fix: $TALIESIN_PYTHON -m pip install ipykernel" >&2
    echo "  or: unset TALIESIN_PYTHON to run the suite with those tests skipped." >&2
    exit 1
fi

# No interpreter at all: run anyway, but never silently. A fresh clone has no `.venv`,
# and a hook that refuses to run there would be a worse gate than one that reports its
# own reduced coverage.
if [ -z "${TALIESIN_PYTHON:-}" ]; then
    echo "pre-push: no TALIESIN_PYTHON and no ./.venv/bin/python — the live-kernel tests"
    echo "          in the suite below will SKIP. This push is gated on less than usual."
fi

echo "pre-push: gating main (fmt, clippy, test, docs lint, site compose). Bypass with --no-verify."
echo "  [1/5] cargo fmt --check"
cargo fmt --all -- --check
echo "  [2/5] cargo clippy --workspace --all-targets -- -D warnings"
cargo clippy --workspace --all-targets -- -D warnings
echo "  [3/5] cargo test --workspace"
cargo test --workspace

# The document gate the `check` verb never had wired anywhere. The two books under `docs/`
# are this project's own manual, authored in `.tmd`, so a broken cross-reference or a dead
# link in either ships to a reader the same way a bug ships to a user, and until 2026-08-08
# nothing automatic looked. `--check-only` renders in memory and writes NOTHING, so the hook
# leaves no `_site/` behind; `--no-exec` is redundant with it and passed anyway, because a
# hook that silently gained a kernel dependency would start failing for the wrong reason.
# `--strict` is deliberately absent: advice must not block a push.
#
# BOTH books, because wave 9 wired only the guide and covered one of two. `docs/internals`
# was built by the composition script (a plain `build … --out`, which exits 0 on any number
# of errors) and linted by nothing. `gate_script.rs` now derives the book list from the tree
# and fails if any `_site.yml` project under `docs/` is missing from this file.
#
# Built with the same profile the tests just used, so this costs a link and not a rebuild.
echo "  [4/5] cargo run -q -p taliesin-server -- build docs/{guide,internals} --check-only --no-exec"
cargo run -q -p taliesin-server -- build docs/guide --check-only --no-exec
cargo run -q -p taliesin-server -- build docs/internals --check-only --no-exec

# The publish gate. FOUR separate projects, four Cloudflare Pages deploys, four domains:
# the marketing site, the two docs books and the gallery each build alone, and they reach
# each other by absolute URL rather than by composition (Cloudflare Pages has no subpath
# deploy, so a composed tree would have to be re-uploaded whole on every change).
#
# `--check` lints and builds all four with --no-exec into temp dirs. build.rs recorded
# that an unrun script had already shipped this project's call-to-action with a 404 once
# (item 149), which is why this runs here rather than by hand.
echo "  [5/5] tools/publish.sh --check"
tools/publish.sh --check
echo "pre-push: all checks passed."
