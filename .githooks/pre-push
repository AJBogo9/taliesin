#!/usr/bin/env bash
# Pre-push gate. Runs the fast, environment-independent checks LOCALLY before a push
# reaches origin, so a break is caught here instead of after it has landed on main.
#
# As of 2026-07-26 this is the ONLY automatic gate in the repo: the GitHub Actions
# workflow was deleted (it billed Actions minutes on this private repo), so the jobs it
# alone ran now run nowhere and are manual. Deliberately still NOT gated here, because
# each needs an environment this hook cannot assume:
#   - live-kernel tests   (need a clean python env / R; also timing-sensitive)
#   - JS typecheck + VS Code grammar  (need node)
#   - cargo audit / cargo deny advisory scan  (need the tools + network; run them on
#                                              any dependency change)
#
# Only gates a push that includes main; WIP-branch pushes skip for speed (matching CI,
# which reserves the heavy gate for main + PRs). Bypass once with:  git push --no-verify
set -euo pipefail

# pre-push receives "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
# Read them ONCE into an array: stdin is a stream, so a second loop would see nothing.
refs=()
pushing_main=0
while read -r local_ref local_sha remote_ref remote_sha; do
    refs+=("$local_ref $local_sha $remote_ref $remote_sha")
    if [ "$remote_ref" = "refs/heads/main" ]; then
        pushing_main=1
    fi
done

cd "$(git rev-parse --show-toplevel)"

# ---------------------------------------------------------------------------
# Guard: refuse a push that ADDS a money/strategy note.
#
# Runs on every push, not just main, because a WIP branch can carry one just as
# easily. It matches only files ADDED by the pushed commits (--diff-filter=A):
# the purge set is still tracked today, so a check against the whole tree would
# refuse every push. Strategy notes belong in ~/Documents/personal/taliesin-private/.
# ---------------------------------------------------------------------------
purge_re='(^|/)(STARTUP-PLAN|FUNDING-RESEARCH)\.md$'
purge_re+='|(pmf-audit|due-diligence-audit|demand-positioning-audit|launch-critique|adoption-friction-audit)\.md$'
purge_re+='|(^|/)phase-2-inputs/'
zero='0000000000000000000000000000000000000000'
offenders=""
for line in "${refs[@]}"; do
    read -r _lref lsha _rref rsha <<<"$line"
    [ "$lsha" = "$zero" ] && continue          # branch deletion, nothing added
    if [ "$rsha" = "$zero" ]; then
        # New remote branch: diff against whatever is already published.
        base=$(git merge-base "$lsha" origin/main 2>/dev/null || true)
        [ -z "$base" ] && continue             # cannot establish a base; do not guess
    else
        base="$rsha"
    fi
    added=$(git diff --diff-filter=A --name-only "$base" "$lsha" 2>/dev/null || true)
    [ -n "$added" ] && offenders+=$(printf '%s\n' "$added" | grep -E "$purge_re" || true)
done
if [ -n "${offenders//[[:space:]]/}" ]; then
    echo "pre-push: REFUSED. These commits add money/strategy notes:" >&2
    printf '%s\n' "$offenders" | sed '/^$/d' | sort -u | sed 's/^/  /' >&2
    echo "" >&2
    echo "Those live in ~/Documents/personal/taliesin-private/, never in the repo." >&2
    echo "Deliberate? git push --no-verify" >&2
    exit 1
fi

if [ "$pushing_main" -eq 0 ]; then
    exit 0
fi

echo "pre-push: gating main (fmt, clippy, test). Bypass with --no-verify."
echo "  [1/3] cargo fmt --check"
cargo fmt --all -- --check
echo "  [2/3] cargo clippy --workspace --all-targets -- -D warnings"
cargo clippy --workspace --all-targets -- -D warnings
echo "  [3/3] cargo test --workspace"
cargo test --workspace
echo "pre-push: all checks passed."
