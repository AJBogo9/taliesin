        "image-alt": {},
        "lead": {}
      },
      "type": "object"
    },
    "image": {},
    "image-alt": {},
    "include-after-body": {},
    "include-before-body": {},
    "include-in-header": {},
    "lang": {},
    "links": {},
    "listing": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "categories": {
              "type": "boolean"
            },
            "contents": {},
            "id": {},
            "max-items": {
              "type": "integer"
            },
            "sort": {},
            "type": {}
          },
          "type": "object"
        },
        {
          "items": {
            "additionalProperties": false,
            "properties": {
              "categories": {
                "type": "boolean"
              },
              "contents": {},
              "id": {},
              "max-items": {
                "type": "integer"
              },
              "sort": {},
              "type": {}
            },
            "type": "object"
          },
          "type": "array"
        }
      ]
    },
    "logo": {},
    "page-layout": {},
    "prose-lint": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "additionalProperties": false,
          "properties": {
            "banned": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      ]
    },
    "subtitle": {},
    "theme": {},
    "theorems": {
      "additionalProperties": false,
      "properties": {
        "numbered": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "enum": [
                "unless-unique"
              ],
              "type": "string"
            }
          ]
        },
        "shared": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
