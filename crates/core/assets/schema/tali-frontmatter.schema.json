      "additionalProperties": false,
      "properties": {
        "cache": {
          "type": "boolean"
        },
        "echo": {
          "type": "boolean"
        },
        "include": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "footer": {},
    "format": {},
