{
  "name": "taliesin-companion",
  "displayName": "Taliesin Companion",
  "description": "Live preview + bidirectional source sync for Taliesin .tmd documents.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "taliesin",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/AJBogo9/taliesin.git",
    "directory": "editor/vscode"
  },
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=18"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets",
    "Notebooks"
  ],
  "keywords": [
    "taliesin",
    "tmd",
    "markdown",
    "literate programming",
    "slides"
  ],
  "icon": "icons/icon.png",
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "taliesin",
        "aliases": [
          "Taliesin",
          "tmd"
        ],
        "extensions": [
          ".tmd"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/tmd.svg",
          "dark": "./icons/tmd.svg"
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "taliesin.getStarted",
        "title": "Get started with Taliesin",
        "description": "Preview a .tmd document live, and let the editor carry the format.",
        "steps": [
          {
            "id": "taliesin.setup",
            "title": "Check your setup",
            "description": "The companion answers nothing on its own: it is a client over `taliesin lsp`. Confirm the binary is there.\n[Diagnose Setup](command:taliesin.doctor)",
            "media": {
              "markdown": "walkthroughs/setup.md"
            },
            "completionEvents": [
              "onCommand:taliesin.doctor"
            ]
          },
          {
            "id": "taliesin.preview",
            "title": "Open a live preview",
            "description": "Block-level updates as you type, and Ctrl+click to jump from the preview back to the source line.\n[Open Preview](command:taliesin.openPreview)",
            "media": {
              "markdown": "walkthroughs/preview.md"
            },
            "completionEvents": [
              "onCommand:taliesin.openPreview"
            ]
          },
          {
            "id": "taliesin.write",
            "title": "Let the editor help you write",
            "description": "Completion for classes, attributes, paths, cell options and math — plus a symbol picker for what you cannot spell.\n[Insert Math Symbol](command:taliesin.insertMathSymbol)",
            "media": {
              "markdown": "walkthroughs/write.md"
            },
            "completionEvents": [
              "onCommand:taliesin.insertMathSymbol"
            ]
          },
          {
            "id": "taliesin.check",
            "title": "Check before you publish",
            "description": "Cross-references, citations, links and front-matter keys, validated the way the build validates them.\n[Check This Document](command:taliesin.check)",
            "media": {
              "markdown": "walkthroughs/check.md"
            },
            "completionEvents": [
              "onCommand:taliesin.check"
            ]
          }
        ]
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": "_site.yml",
        "url": "./schema/tali-site.schema.json"
      }
    ],
    "grammars": [
      {
        "language": "taliesin",
        "scopeName": "text.tmd.markdown",
        "path": "./syntaxes/tmd.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.frontmatter": "yaml",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.r": "r",
          "meta.embedded.block.js": "javascript",
          "meta.embedded.block.julia": "julia",
          "meta.embedded.block.mermaid": "mermaid",
          "meta.embedded.block.sql": "sql",
          "meta.embedded.math.tmd": "latex"
        }
      },
      {
        "scopeName": "text.tmd.markdown.injection",
        "path": "./syntaxes/tmd.injection.tmLanguage.json",
        "injectTo": [
          "text.tmd.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.math.tmd": "latex"
        }
      }
    ],
    "snippets": [
      {
        "language": "taliesin",
        "path": "./snippets/tmd.json"
      }
    ],
    "commands": [
      {
        "command": "taliesin.openPreview",
        "title": "Open Preview",
        "category": "Taliesin",
        "icon": "$(open-preview)"
      },
      {
        "command": "taliesin.revealInPreview",
        "title": "Reveal Cursor in Preview",
        "category": "Taliesin"
      },
      {
        "command": "taliesin.runCell",
        "title": "Run Cell",
        "category": "Taliesin",
        "icon": "$(play)"
      },
      {
        "command": "taliesin.runAll",
        "title": "Run All Cells",
        "category": "Taliesin",
        "icon": "$(run-all)"
      },
      {
        "command": "taliesin.check",
        "title": "Check This Document",
        "category": "Taliesin"
      },
      {
        "command": "taliesin.restartServer",
        "title": "Restart Language Server",
        "category": "Taliesin"
      },
      {
        "command": "taliesin.showServerLog",
        "title": "Show Language Server Log",
        "category": "Taliesin"
      },
      {
        "command": "taliesin.doctor",
        "title": "Diagnose Setup (doctor)",
        "category": "Taliesin"
      },
      {
        "command": "taliesin.insertMathSymbol",
        "title": "Insert Math Symbol",
        "category": "Taliesin"
      },
      {
        "command": "taliesin.moveSectionUp",
        "title": "Move Section Up",
        "category": "Taliesin"
      },
      {
        "command": "taliesin.moveSectionDown",
        "title": "Move Section Down",
        "category": "Taliesin"
      },
      {
        "command": "taliesin.promoteHeading",
        "title": "Promote Heading (fewer #)",
        "category": "Taliesin"
      },
      {
        "command": "taliesin.demoteHeading",
        "title": "Demote Heading (more #)",
        "category": "Taliesin"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "taliesin.openPreview",
          "when": "resourceExtname == .tmd",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "taliesin.check",
          "when": "resourceExtname == .tmd"
        },
        {
          "command": "taliesin.insertMathSymbol",
          "when": "editorLangId == taliesin"
        },
        {
          "command": "taliesin.revealInPreview",
          "when": "resourceExtname == .tmd"
        }
      ]
    },
    "keybindings": [
      {
        "command": "taliesin.openPreview",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "editorLangId == taliesin"
      },
      {
        "command": "taliesin.insertMathSymbol",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorLangId == taliesin && editorTextFocus"
      },
      {
        "command": "taliesin.revealInPreview",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j",
        "when": "editorLangId == taliesin && editorTextFocus"
      },
      {
        "command": "taliesin.moveSectionUp",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "editorLangId == taliesin && editorTextFocus"
      },
      {
        "command": "taliesin.moveSectionDown",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "editorLangId == taliesin && editorTextFocus"
      },
      {
        "command": "taliesin.promoteHeading",
        "key": "ctrl+alt+[",
        "mac": "cmd+alt+[",
        "when": "editorLangId == taliesin && editorTextFocus"
      },
      {
        "command": "taliesin.demoteHeading",
        "key": "ctrl+alt+]",
        "mac": "cmd+alt+]",
        "when": "editorLangId == taliesin && editorTextFocus"
      }
    ],
    "configurationDefaults": {
      "[taliesin]": {
        "editor.wordWrap": "on",
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        }
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "punctuation.definition.math.begin.tmd",
              "punctuation.definition.math.end.tmd"
            ],
            "settings": {
              "fontStyle": "bold"
            }
          }
        ]
      }
    },
    "configuration": {
      "title": "Taliesin",
      "properties": {
        "taliesin.path": {
          "type": "string",
          "default": "taliesin",
          "scope": "machine",
          "markdownDescription": "Path to the `taliesin` executable (default: the `taliesin` launcher on `PATH`).\n\nMachine-scoped on purpose: this names a program the extension executes, so a repository's own `.vscode/settings.json` must not be able to redirect it."
        },
        "taliesin.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the traffic between the editor and `taliesin lsp` to the Taliesin Language Server output channel."
        },
        "taliesin.explorerBadges": {
          "type": "boolean",
          "default": true,
          "description": "Badge .tmd files in the Explorer with their worst `taliesin check` severity. Runs `check` on save."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "taliesin",
          "title": "Taliesin",
          "icon": "icons/sidebar.svg"
        }
      ]
    },
    "views": {
      "taliesin": [
        {
          "id": "taliesin.outline",
          "name": "Outline",
          "contextualTitle": "Taliesin: whole-book outline"
        },
        {
          "id": "taliesin.references",
          "name": "References",
          "contextualTitle": "Taliesin: cross-references, dangling grouped"
        },
        {
          "id": "taliesin.floats",
          "name": "Figures & Tables",
          "contextualTitle": "Taliesin: numbered float index"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "taliesin",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "check",
              "build",
              "build --out"
            ],
            "description": "Which Taliesin command this task runs against the project root."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "taliesin",
        "owner": "taliesin",
        "source": "taliesin",
        "severity": "info",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^([^\\s:][^:]*):(\\d+): (error|warning|suggestion)\\[([^\\]]+)\\]: (.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        }
      },
      {
        "name": "taliesin-unlocated",
        "owner": "taliesin",
        "source": "taliesin",
        "severity": "info",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^([^\\s:][^:]*): (error|warning|suggestion)\\[([^\\]]+)\\]: (.*)$",
          "file": 1,
          "severity": 2,
          "code": 3,
          "message": 4
        }
      }
    ],
    "languageModelTools": [
      {
        "name": "taliesin_check",
        "displayName": "Check a Taliesin document",
        "toolReferenceName": "tali-check",
        "modelDescription": "Validate a .tmd file or project directory. Runs no code and touches no network. Returns each diagnostic with a stable code, severity, file and line, and a suggested replacement for a typo. Use this to verify a document is correct before claiming it is.",
        "canBeReferencedInPrompt": true,
        "icon": "$(book)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path to a .tmd file or a project directory containing _site.yml."
            }
          },
          "required": [
            "path"
          ]
        }
      },
      {
        "name": "taliesin_read",
        "displayName": "Read a rendered Taliesin document",
        "toolReferenceName": "tali-read",
        "modelDescription": "Project a rendered .tmd document to plain text: headings, resolved figure and cross-reference numbers, callouts, fenced code, and math as TeX. This is what the document actually says once built, as opposed to its source.",
        "canBeReferencedInPrompt": true,
        "icon": "$(book)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path to a .tmd file."
            }
          },
          "required": [
            "path"
          ]
        }
      },
      {
        "name": "taliesin_symbols",
        "displayName": "List a document's cross-reference targets",
        "toolReferenceName": "tali-symbols",
        "modelDescription": "List every cross-reference anchor a .tmd document defines, with its resolved number. Use this to find the correct @-name before writing a reference, instead of guessing one.",
        "canBeReferencedInPrompt": true,
        "icon": "$(book)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path to a .tmd file."
            }
          },
          "required": [
            "path"
          ]
        }
      },
      {
        "name": "taliesin_map",
        "displayName": "Outline a Taliesin project",
        "toolReferenceName": "tali-map",
        "modelDescription": "Outline a whole project directory: its pages in nav or chapter order, the nav itself, any mounts, and the cross-reference graph between pages. Use this to understand a book or site before editing part of it.",
        "canBeReferencedInPrompt": true,
        "icon": "$(book)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path to a project directory containing _site.yml."
            }
          },
          "required": [
            "path"
          ]
        }
      },
      {
        "name": "taliesin_vocab",
        "displayName": "List the vocabulary Taliesin accepts",
        "toolReferenceName": "tali-vocab",
        "modelDescription": "The closed-set vocabulary Taliesin accepts: front-matter keys, cell options, callout and theorem kinds, div classes, and cross-reference prefixes. Use this instead of guessing whether a key or class exists.",
        "canBeReferencedInPrompt": true,
        "icon": "$(book)",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "taliesin",
        "label": "Taliesin"
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Taliesin runs the `taliesin` binary to lint and preview documents. The binary path is machine-scoped so an untrusted folder cannot redirect it, but the preview executes the document's code cells.",
      "restrictedConfigurations": [
        "taliesin.path"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The language server and preview both read files from disk."
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build -- --minify",
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "compile-tests": "tsc -p . --outDir out",
    "test": "npm run compile-tests && node --test out/test/*.test.js",
    "test:e2e": "npm run compile-tests && node out/e2e/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "1.101.0",
    "@vscode/test-electron": "^2.4.0",
    "esbuild": "^0.21.0",
    "glob": "^10.3.0",
    "mocha": "^10.4.0",
    "typescript": "^5.4.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  }
}
