{
  "name": "qmd-fast-companion",
  "displayName": "qmd-fast Companion",
  "description": "Live preview + bidirectional source sync for qmd-fast .qmd documents.",
  "version": "0.1.0",
  "publisher": "qmd-fast",
  "private": true,
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:taliesin"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "taliesin",
        "aliases": [
          "Taliesin",
          "tmd"
        ],
        "extensions": [
          ".tmd"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/tmd.svg",
          "dark": "./icons/tmd.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "taliesin",
        "scopeName": "text.tmd.markdown",
        "path": "./syntaxes/tmd.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.frontmatter": "yaml",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.r": "r",
          "meta.embedded.block.js": "javascript",
          "meta.embedded.block.julia": "julia",
          "meta.embedded.block.mermaid": "mermaid",
          "meta.embedded.block.sql": "sql",
          "meta.embedded.math.tmd": "latex"
        }
      },
      {
        "scopeName": "text.tmd.markdown.injection",
        "path": "./syntaxes/tmd.injection.tmLanguage.json",
        "injectTo": ["text.tmd.markdown"],
        "embeddedLanguages": {
          "meta.embedded.math.tmd": "latex"
        }
      }
    ],
    "commands": [
      {
        "command": "qmdFast.openPreview",
        "title": "qmd-fast: Open Preview",
        "category": "qmd-fast"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "qmdFast.openPreview",
          "when": "resourceExtname == .tmd || resourceExtname == .qmd",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "qmd-fast",
      "properties": {
        "qmdFast.path": {
          "type": "string",
          "default": "qmd-fast",
          "description": "Path to the qmd-fast executable (default: the qmd-fast launcher on PATH)."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "compile-tests": "tsc -p . --outDir out",
    "test": "npm run compile-tests && node --test out/test",
    "test:e2e": "npm run compile-tests && node out/e2e/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.0",
    "esbuild": "^0.21.0",
    "glob": "^10.3.0",
    "mocha": "^10.4.0",
    "typescript": "^5.4.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
