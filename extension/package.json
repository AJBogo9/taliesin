{
  "name": "qmd-fast",
  "displayName": "qmd-fast preview",
  "description": "Live, block-incremental preview for .qmd files with click-to-source.",
  "version": "0.0.1",
  "publisher": "ajbogo9",
  "repository": "https://github.com/AJBogo9/qmd-fast",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "qmd-fast.openPreview",
        "title": "Open Preview",
        "category": "qmd-fast"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "qmd-fast.openPreview",
          "when": "resourceExtname == .qmd",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "qmd-fast.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "resourceExtname == .qmd"
      }
    ],
    "configuration": {
      "title": "qmd-fast",
      "properties": {
        "qmd-fast.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the qmd-fast binary. If empty, the extension searches the workspace target/{release,debug} directories and then PATH."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
