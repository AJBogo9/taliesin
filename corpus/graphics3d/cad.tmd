---
title: "CAD: loaded and computed"
description: "A real 3D model rendered in the page, beside a spur gear the document computes from three numbers."
toc: false
---

Two ways to put a 3-D part on a page. On the left, a **real, materials-rich model**,
loaded and rendered live from a `.glb` file. On the right, a spur gear the document
**computes** from its module, tooth count, and pressure angle: drag the sliders and
the mesh regenerates from the involute equations. One is geometry you bring; the
other is geometry the page derives.

{{< include _includes/three-scene.tmd >}}

## A real model, rendered live

```{js}
//| name: cad-viewer
//| echo: false
const makeScene3D = tali.get("makeScene3D");
const MODEL_FILE = "assets/ToyCar.glb";
const el = document.createElement("div");
makeScene3D(async (scene, THREE, ctx) => {
  const key = new THREE.DirectionalLight(0xffffff, 1.1);
  key.position.set(6, 10, 8); scene.add(key);
  const fill = new THREE.DirectionalLight(0xffffff, 0.4);
  fill.position.set(-6, -3, -8); scene.add(fill);
  await ctx.loadGLTF(MODEL_FILE);   // auto-frames the camera to the model
}, invalidation, { bgColor: 0x11151f }).then((n) => el.appendChild(n));
return el;
```

*Model: **ToyCar**, a Khronos glTF sample asset, [CC0 1.0](https://creativecommons.org/publicdomain/zero/1.0/) (public domain).*

## A gear, computed from three numbers

```{js}
//| name: cad-gear
//| echo: false
const makeScene3D = tali.get("makeScene3D");
const P = { module: 0.5, teeth: 18, pressure: 20 };

// One involute spur-gear cross-section, extruded into a 3-D gear.
function gearShape(THREE, { module: m, teeth: z, pressure }) {
  const alpha = pressure * Math.PI / 180;
  const rp = m * z / 2;             // pitch radius
  const rb = rp * Math.cos(alpha);  // base radius (involute starts here)
  const ra = rp + m;                // addendum (tip)
  const rootStart = Math.max(0.4, rp - 1.25 * m);
  const invAlpha = Math.tan(alpha) - alpha;
  const halfTooth = Math.PI / (2 * z);

  // polar-angle offset of the involute at radius r (r >= rb)
  const inv = (r) => {
    const beta = Math.acos(Math.min(1, rb / r));
    return Math.tan(beta) - beta;
  };
  // right-flank angle at radius r, tooth centered on angle 0
  const flankAngle = (r) => halfTooth + invAlpha - inv(r);

  const rLo = Math.max(rb, rootStart);
  const N = 8;
  const tooth = [];
  for (let i = 0; i <= N; i++) {            // right flank, root → tip
    const r = rLo + (ra - rLo) * i / N;
    const a = flankAngle(r);
    tooth.push([r * Math.cos(a), r * Math.sin(a)]);
  }
  for (let i = N; i >= 0; i--) {            // left flank, tip → root (mirror)
    const r = rLo + (ra - rLo) * i / N;
    const a = -flankAngle(r);
    tooth.push([r * Math.cos(a), r * Math.sin(a)]);
  }

  const shape = new THREE.Shape();
  for (let k = 0; k < z; k++) {
    const rot = k * 2 * Math.PI / z, c = Math.cos(rot), s = Math.sin(rot);
    for (let idx = 0; idx < tooth.length; idx++) {
      const [x, y] = tooth[idx];
      const X = x * c - y * s, Y = x * s + y * c;
      if (k === 0 && idx === 0) shape.moveTo(X, Y);
      else shape.lineTo(X, Y);
    }
  }
  shape.closePath();
  const hole = new THREE.Path();
  hole.absarc(0, 0, Math.max(0.5, rb * 0.4), 0, Math.PI * 2, true);
  shape.holes.push(hole);
  return shape;
}

const el = document.createElement("div");
let gearGroup, THREEref, regen;

function makeGear(g) {
  const T = THREEref;
  const geo = new T.ExtrudeGeometry(gearShape(T, P), { depth: P.module * 3, bevelEnabled: false });
  geo.center();
  g.add(new T.Mesh(geo, new T.MeshStandardMaterial({
    color: 0xb8c2d0, metalness: 0.7, roughness: 0.35,
  })));
}

makeScene3D((scene, THREE, ctx) => {
  THREEref = THREE;
  const key = new THREE.DirectionalLight(0xffffff, 1.1);
  key.position.set(4, 8, 6); scene.add(key);
  gearGroup = new THREE.Group(); scene.add(gearGroup);
  regen = () => { ctx.rebuild(gearGroup, makeGear); ctx.frameObject(gearGroup, 1.5); };
  regen();
}, invalidation, {
  cameraPos: [0, 4, 10], bgColor: 0x11151f,
  controls: [
    { type: "range", label: "Teeth", min: 6, max: 40, step: 1, value: P.teeth,
      onInput: (v) => { P.teeth = v; regen(); } },
    { type: "range", label: "Module", min: 0.2, max: 1, step: 0.05, value: P.module,
      onInput: (v) => { P.module = v; regen(); } },
    { type: "range", label: "Pressure", min: 14.5, max: 25, step: 0.5, value: P.pressure,
      onInput: (v) => { P.pressure = v; regen(); } },
  ],
}).then((n) => el.appendChild(n));

return el;
```

The gear is not a stored asset. It is recomputed from the involute equations every
time you move a slider: change the tooth count and the page redraws a valid gear.
